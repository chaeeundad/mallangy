{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mallangy-ar",
  "main": "index.mjs",
  "compatibility_date": "2026-11-23",
  "vars": {
    "ALLOWED_ORIGIN": "https://replace-with-your-exact-vercel-domain.example",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mallangy-ar",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
}
